---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import portrait from '../assets/portrait.jpg';
import { content, type Content, type Page } from '../i18n/content';
import { site } from '../data/site';
import { url } from '../lib/url';
// Image flags, not emoji: emoji flags don't render on Windows.
import flagEn from '../assets/flags/en.svg?url';
import flagSq from '../assets/flags/sq.svg?url';

interface Props {
  c: Content;
  page: Page;
  title: string;
  description: string;
}

const { c, page, title, description } = Astro.props;
const other = c.lang === 'sq' ? content.en : content.sq;
const flag = other.lang === 'en' ? flagEn : flagSq;
const abs = (path: string) => new URL(url(path), Astro.site).href;
const canonical = abs(c.routes[page]);
const ogImage = new URL(portrait.src, Astro.site);
const year = new Date().getFullYear();

const dayCodes = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: site.firm,
  url: abs(c.routes.home),
  image: ogImage.href,
  telephone: site.phone,
  email: site.email || undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.building}`,
    addressLocality: site.address.city,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days.map((d) => `https://schema.org/${['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'][d - 1]}`),
    opens: h.open,
    closes: h.close,
  })),
  openingHours: site.hours.map((h) => `${h.days.map((d) => dayCodes[d - 1]).join(',')} ${h.open}-${h.close}`),
  founder: { '@type': 'Person', name: site.lawyer, jobTitle: c.role },
};
---

<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sq" href={abs(content.sq.routes[page])} />
    <link rel="alternate" hreflang="en" href={abs(content.en.routes[page])} />
    <link rel="alternate" hreflang="x-default" href={abs(content.sq.routes[page])} />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#0e1d3a" />
    {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={page === 'home' ? 'profile' : 'website'} />
    <meta property="og:site_name" content={site.firm} />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage.href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url(c.routes.home)} aria-label={site.firm}>
          <Image src={logo} alt="" width={48} height={48} loading="eager" />
          <span>
            <strong>{site.firm}</strong>
            <small>Av. {site.lawyer}</small>
          </span>
        </a>
        <nav id="site-nav" aria-label="Main">
          <a href={`${url(c.routes.home)}#profile`} aria-current={page === 'home' ? 'page' : undefined}>{c.nav.profile}</a>
          <a href={url(c.routes.studio)} aria-current={page === 'studio' ? 'page' : undefined}>{c.nav.studio}</a>
          <a href={`${url(c.routes.studio)}#${c.practiceAnchor}`}>{c.nav.practice}</a>
          <a href={`${url(c.routes.home)}#contact`}>{c.nav.contact}</a>
          <a class="lang" href={url(other.routes[page])} hreflang={other.lang} lang={other.lang} title={c.switchLabel}>
            <img src={flag} alt="" width="28" height="21" />
            <span class="lang-label">{c.switchLabel}</span>
          </a>
        </nav>
        <div class="tools">
          <a class="call" href={site.phoneHref} aria-label={`${c.labels.call} ${site.phone}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
            <span>{site.phone}</span>
          </a>
          <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={c.labels.menu}>
            <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="2" d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <Image src={logo} alt="" width={72} height={72} />
          <div>
            <strong>{site.firm}</strong>
            <span>Av. {site.lawyer}</span>
          </div>
        </div>
        <address>
          {site.address.street}, {site.address.building}<br />
          {site.address.postcode} {site.address.city}, {c.lang === 'sq' ? 'Shqipëri' : 'Albania'}<br />
          <a href={site.phoneHref}>{site.phone}</a>
          {site.email && <><br /><a href={`mailto:${site.email}`}>{site.email}</a></>}
        </address>
        <p class="disclaimer">{c.disclaimer}</p>
      </div>
      <div class="wrap copy">
        <span>© {year} {site.firm}. {c.rights}</span>
        <span>{c.credit} <a href="https://marketixo.eu/" target="_blank" rel="noopener">Marketixo</a></span>
      </div>
    </footer>
  </body>
</html>

<script>
  // Mobile menu: the nav drops down under the header bar.
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 961px)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 100;
    padding: 8px 14px;
    background: var(--gold);
    color: var(--navy);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(14 29 58 / 0.96);
    backdrop-filter: blur(8px);
    color: var(--white);
    border-bottom: 1px solid rgb(195 154 69 / 0.35);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand img {
    width: 48px;
    height: 48px;
  }

  .brand span {
    display: grid;
    line-height: 1.2;
  }

  .brand strong {
    white-space: nowrap;
    font: 600 21px/1.1 var(--serif);
    letter-spacing: 0.02em;
  }

  .brand small {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    margin-left: auto;
  }

  nav a {
    white-space: nowrap;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.85;
    transition: color 0.2s, opacity 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--gold);
    opacity: 1;
  }

  nav .lang {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 3px;
    border: 1px solid transparent;
    opacity: 1;
    transition: border-color 0.2s;
  }

  /* desktop: flag only, the name stays for screen readers */
  .lang-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  nav .lang:hover {
    border-color: var(--gold);
  }

  .lang img {
    width: 28px;
    height: 21px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .call {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  .call:hover {
    background: var(--gold);
    color: var(--navy);
  }

  .call svg {
    width: 16px;
    height: 16px;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 960px) {
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--navy);
      border-bottom: 1px solid rgb(195 154 69 / 0.35);
      box-shadow: 0 24px 40px -20px rgb(0 0 0 / 0.5);
    }

    .is-open nav {
      display: flex;
    }

    nav a {
      padding: 16px 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
      font-size: 14px;
    }

    nav a:last-child {
      border-bottom: 0;
    }

    nav .lang,
    nav .lang:hover {
      padding: 16px 0;
      border: 0;
    }

    .lang-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .tools {
      margin-left: auto;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      padding: 0;
      border: 1px solid rgb(255 255 255 / 0.3);
      background: none;
      color: var(--white);
      cursor: pointer;
    }

    .menu-toggle svg {
      width: 22px;
      height: 22px;
    }

    .icon-close,
    .is-open .icon-open {
      display: none;
    }

    .is-open .icon-close {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .bar {
      gap: 12px;
      min-height: 64px;
    }

    .brand img {
      width: 40px;
      height: 40px;
    }

    .brand strong {
      font-size: 18px;
    }

    .call span {
      display: none;
    }

    .call {
      padding: 10px;
    }

    .tools {
      gap: 10px;
    }
  }

  .site-footer {
    background: var(--navy);
    color: rgb(255 255 255 / 0.78);
    font-size: 14px;
    padding-top: 56px;
  }

  .foot {
    display: grid;
    grid-template-columns: auto 1fr 1.4fr;
    gap: 40px;
    align-items: start;
    padding-bottom: 40px;
  }

  .foot-brand {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .foot-brand div {
    display: grid;
  }

  .foot-brand strong {
    font: 600 22px/1.2 var(--serif);
    color: var(--white);
  }

  .foot-brand span {
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  address {
    font-style: normal;
  }

  address a {
    text-decoration: none;
    color: var(--white);
  }

  .disclaimer {
    font-size: 13px;
    color: rgb(255 255 255 / 0.6);
    margin: 0;
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 12px;
    color: rgb(255 255 255 / 0.5);
  }

  .copy a {
    color: var(--gold);
    text-decoration: none;
  }

  .copy a:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .foot {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media print {
    .site-header,
    .site-footer {
      display: none;
    }
  }
</style>
